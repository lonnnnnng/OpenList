[Unit]
Description=OpenList server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/openlist
ExecStart=%h/openlist/openlist --data %h/openlist/data --config %h/openlist/config.json server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/openlist

[Install]
WantedBy=default.target
